entrypoint = "README.md"
modules = ["python-3.11", "nodejs-20", "javascript", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["github:1.0.0", "google-sheet:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "profile-completion-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Temporary Toronto production heartbeat"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 CI=1 npx expo start --localhost --non-interactive"
waitForPort = 8081

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "profile-completion-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/test-profile-completion.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "Temporary Toronto production heartbeat"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'set -euo pipefail; while true; do hour=$(TZ=America/Toronto date +%H); if [ \"$hour\" -lt 16 ] || [ \"$hour\" -ge 18 ]; then echo \"Toronto heartbeat window closed; stopping.\"; exit 0; fi; echo \"$(TZ=America/Toronto date -Iseconds) pinging production health\"; curl --fail --silent --show-error --location --retry 2 --retry-delay 2 --max-time 20 https://circles-bridges.replit.app/api/health; echo; sleep 300; done'"

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
APNS_BUNDLE_ID = "app.replit.bridges"
APNS_KEY_ID = "A95GG3Y47Y"
APNS_TEAM_ID = "5BJJ2KP2X5"
