{
  "expo": {
    "name": "Bridges",
    "slug": "bridges",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "bridges",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0718"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.bridges",
      "buildNumber": "24",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": [
          "Default",
          "Default"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.bridges.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0718",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://circles-by-bridges.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#9B7DFF"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Bridges uses your contacts to help you import people into your relationship circles so you can stay connected with the people who matter most."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bridges uses your photo library so you can add profile photos for yourself and your contacts.",
          "cameraPermission": "Bridges uses your camera so you can take profile photos for yourself and your contacts."
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "apiUrl": "https://circles-by-bridges.replit.app",
      "eas": {
        "projectId": "603f7533-c3a7-487e-b378-d076df17514a"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
